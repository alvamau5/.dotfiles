# This is the configuration file for Ghostty.
#
# Config syntax crash course
# ==========================
# # The config file consists of simple key-value pairs,
# # separated by equals signs.
#   Route for Linux
#   /home/alvamau5/.config/ghostty/config
#   Route for macOS
#   /Users/lucio/Library/Application Support/com.mitchellh.ghostty/config
#
theme = ENCOM
font-size = 12.5
font-family = CaskaydiaCove Nerd Font Mono
gtk-titlebar = false
title = "Ghostty"
gtk-wide-tabs = false
gtk-tabs-location = hidden
window-theme = dark
window-decoration = true
window-padding-x = 10
window-padding-y = 10
window-padding-balance = true
shell-integration = zsh
mouse-hide-while-typing = true
cursor-style-blink = true
unfocused-split-opacity = 0.85
#
# macOS-specific settings
macos-titlebar-style = tabs
macos-option-as-alt = true
#
# # Spacing around the equals sign does not matter.
# # All of these are identical:
keybind = ctrl+shift+k=next_tab
keybind = ctrl+shift+j=previous_tab
keybind = shift+alt+l=goto_split:right
keybind = shift+alt+h=goto_split:left
keybind = shift+alt+j=goto_split:up
keybind = shift+alt+k=goto_split:down
